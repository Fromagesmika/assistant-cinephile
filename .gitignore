# Secrets : ne JAMAIS versionner les clés d'API
.env

# Environnement Python
.venv/
__pycache__/
*.pyc

# Vidéo : sources lourdes (le rendu final se dépose à part)
video/renders/
video/node_modules/

# Index d'essais : seul l'index retenu (voir src/rag.py) est versionné
data/index/*
!data/index/e5_800_100.npy
cache/requetes/minilm.json

# Liste « à voir » partagée : état de l'application, pas une donnée du projet
data/liste_a_voir.json

# Traces de l'interface : usage réel, pas les résultats de l'évaluation
traces/interface.jsonl

# Affiches TMDB : régénérées par scripts/telecharger_affiches.py (droits des ayants droit)
data/affiches/
