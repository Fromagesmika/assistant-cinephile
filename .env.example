# Copier ce fichier en .env puis coller vos clés. Le fichier .env n'est jamais versionné.

# Clé Gemini : https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Clé TMDB (API v3) : https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Modèle utilisé pour tous les niveaux
CHAT_MODEL=gemini-3.5-flash-lite

# Délai minimal entre deux appels LLM, en secondes (offre gratuite limitée en débit)
LLM_MIN_INTERVAL=6
